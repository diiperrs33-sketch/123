<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HotelAurora.Views.SobrePage" Title="Sobre"
             Shell.NavBarIsVisible="False" BackgroundColor="{StaticResource Canvas}">
  <ScrollView>
    <VerticalStackLayout Padding="24,36,24,32" Spacing="20">
      <Label Text="Hotel Aurora" FontSize="17" FontAttributes="Bold" TextColor="{StaticResource Accent}" />
      <Label Text="Sobre o app" FontSize="29" FontAttributes="Bold" />
      <Border BackgroundColor="White" Stroke="{StaticResource Outline}" StrokeShape="RoundRectangle 12" Padding="20">
        <VerticalStackLayout Spacing="13">
          <Label Text="Sobre o projeto" FontSize="19" FontAttributes="Bold" />
          <Label Text="Fiz esse aplicativo para a Agenda 13 de Programação Mobile I. Nele dá pra escolher um quarto, informar quantas pessoas vão ficar e selecionar as datas. Depois o app mostra o valor da hospedagem."
                 FontSize="14" LineHeight="1.5" />
        </VerticalStackLayout>
      </Border>
      <Border BackgroundColor="White" Stroke="{StaticResource Outline}" StrokeShape="RoundRectangle 12" Padding="20">
        <VerticalStackLayout Spacing="17">
          <Label Text="Informações" FontSize="19" FontAttributes="Bold" />
          <BoxView HeightRequest="1" Color="{StaticResource Outline}" />
          <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="19">
            <Label Grid.Row="0" Text="Feito por" FontSize="14" TextColor="{StaticResource Muted}" />
            <Label Grid.Row="0" Grid.Column="1" Text="João Andrade" FontSize="14" HorizontalTextAlignment="End" />
            <Label Grid.Row="1" Text="Ano" FontSize="14" TextColor="{StaticResource Muted}" />
            <Label Grid.Row="1" Grid.Column="1" Text="2026" FontSize="14" HorizontalTextAlignment="End" />
            <Label Grid.Row="2" Text="Tecnologias" FontSize="14" TextColor="{StaticResource Muted}" />
            <Label Grid.Row="2" Grid.Column="1" Text="C#, XAML e .NET MAUI" FontSize="14" HorizontalTextAlignment="End" />
            <Label Grid.Row="3" Text="Curso" FontSize="14" TextColor="{StaticResource Muted}" />
            <Label Grid.Row="3" Grid.Column="1" Text="Desenvolvimento de Sistemas" FontSize="14" HorizontalTextAlignment="End" />
          </Grid>
        </VerticalStackLayout>
      </Border>
      <Label Text="Agenda 13 — 2026" FontSize="12" TextColor="{StaticResource Muted}" HorizontalTextAlignment="Center" />
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>