<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HotelAurora.Views.SobrePage"
             Title="Sobre" Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Canvas}">
  <ScrollView>
    <VerticalStackLayout Padding="28,26,28,30" Spacing="18" MaximumWidthRequest="660" HorizontalOptions="Fill">
      <Label Text="Hotel Aurora" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource Accent}" />
      <BoxView HeightRequest="1" Color="{StaticResource Outline}" />
      <Label Text="Sobre" FontSize="20" FontAttributes="Bold" Margin="0,2,0,0" />
      <Label Text="Aplicativo para consultar quartos, escolher o período da hospedagem e conferir o valor total antes de continuar." FontSize="15" LineHeight="1.4" />
      <BoxView HeightRequest="1" Color="{StaticResource Outline}" Margin="0,8,0,0" />
      <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="18" ColumnSpacing="10">
        <Label Grid.Row="0" Text="Desenvolvedor" FontSize="14" TextColor="{StaticResource Muted}" />
        <Label Grid.Row="0" Grid.Column="1" Text="João Andrade" FontSize="14" />
        <Label Grid.Row="1" Text="Ano" FontSize="14" TextColor="{StaticResource Muted}" />
        <Label Grid.Row="1" Grid.Column="1" Text="2026" FontSize="14" />
        <Label Grid.Row="2" Text="Tecnologias" FontSize="14" TextColor="{StaticResource Muted}" />
        <Label Grid.Row="2" Grid.Column="1" Text="C#, XAML, .NET MAUI" FontSize="14" />
        <Label Grid.Row="3" Text="Curso" FontSize="14" TextColor="{StaticResource Muted}" />
        <Label Grid.Row="3" Grid.Column="1" Text="Desenvolvimento de Sistemas" FontSize="14" />
      </Grid>
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
