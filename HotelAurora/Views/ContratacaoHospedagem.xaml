<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HotelAurora.Views.ContratacaoHospedagem"
             Shell.NavBarIsVisible="False" BackgroundColor="{StaticResource Canvas}" Title="Reserva">
  <ScrollView>
    <VerticalStackLayout Padding="24,36,24,32" Spacing="20">
      <VerticalStackLayout Spacing="5">
        <Label Text="Hotel Aurora" FontSize="17" FontAttributes="Bold" TextColor="{StaticResource Accent}" />
        <Label Text="Faça sua reserva" FontSize="29" FontAttributes="Bold" />
        <Label Text="Escolha o quarto e as datas pra ver quanto fica." FontSize="14" TextColor="{StaticResource Muted}" />
      </VerticalStackLayout>
      <Border BackgroundColor="White" Stroke="{StaticResource Outline}" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="19,22">
        <VerticalStackLayout Spacing="20">
          <Label Text="Hóspedes" FontSize="18" FontAttributes="Bold" />
          <Grid ColumnDefinitions="*,36,125" RowDefinitions="Auto,Auto" RowSpacing="18" ColumnSpacing="6">
            <Label Grid.Row="0" Text="Adultos" FontSize="15" VerticalTextAlignment="Center" />
            <Label Grid.Row="0" Grid.Column="1" Text="{Binding Value, Source={x:Reference stpAdultos}, StringFormat='{0:F0}'}" FontSize="16" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
            <Stepper Grid.Row="0" Grid.Column="2" x:Name="stpAdultos" Minimum="1" Maximum="8" Increment="1" Value="2" HorizontalOptions="End" />
            <Label Grid.Row="1" Text="Crianças" FontSize="15" VerticalTextAlignment="Center" />
            <Label Grid.Row="1" Grid.Column="1" Text="{Binding Value, Source={x:Reference stpCriancas}, StringFormat='{0:F0}'}" FontSize="16" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
            <Stepper Grid.Row="1" Grid.Column="2" x:Name="stpCriancas" Minimum="0" Maximum="5" Increment="1" Value="0" HorizontalOptions="End" />
          </Grid>
          <BoxView HeightRequest="1" Color="{StaticResource Outline}" />
          <VerticalStackLayout Spacing="8">
            <Label Text="Quarto" FontSize="15" FontAttributes="Bold" />
            <Border BackgroundColor="#FAFBFA" Stroke="{StaticResource Outline}" StrokeShape="RoundRectangle 8" Padding="10,1">
              <Picker x:Name="pckQuarto" Title="Escolha um quarto" FontSize="14" TextColor="{StaticResource Ink}" />
            </Border>
          </VerticalStackLayout>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="13">
            <VerticalStackLayout Spacing="8">
              <Label Text="Entrada" FontSize="15" FontAttributes="Bold" />
              <Border BackgroundColor="#FAFBFA" Stroke="{StaticResource Outline}" StrokeShape="RoundRectangle 8" Padding="5,0">
                <DatePicker x:Name="dtpCheckin" Format="dd/MM/yyyy" FontSize="13" TextColor="{StaticResource Ink}" DateSelected="OnCheckinAlterado" />
              </Border>
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="1" Spacing="8">
              <Label Text="Saída" FontSize="15" FontAttributes="Bold" />
              <Border BackgroundColor="#FAFBFA" Stroke="{StaticResource Outline}" StrokeShape="RoundRectangle 8" Padding="5,0">
                <DatePicker x:Name="dtpCheckout" Format="dd/MM/yyyy" FontSize="13" TextColor="{StaticResource Ink}" />
              </Border>
            </VerticalStackLayout>
          </Grid>
        </VerticalStackLayout>
      </Border>
      <Button Text="Ver valor da hospedagem" Clicked="OnAvancarClicked" />
      <Label Text="Simulação feita para a atividade da Agenda 13." HorizontalTextAlignment="Center" FontSize="12" TextColor="{StaticResource Muted}" />
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>