<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HotelAurora.Views.HospedagemContratada"
             Shell.NavBarIsVisible="False" Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource Canvas}" Title="Resumo">
  <ScrollView>
    <VerticalStackLayout Padding="28,26,28,30" Spacing="18" MaximumWidthRequest="660" HorizontalOptions="Fill">
      <Label Text="Hotel Aurora" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource Accent}" />
      <BoxView HeightRequest="1" Color="{StaticResource Outline}" />
      <Label Text="Resumo da reserva" FontSize="20" FontAttributes="Bold" Margin="0,2,0,6" />
      <Grid ColumnDefinitions="125,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="16" ColumnSpacing="12">
        <Label Grid.Row="0" Text="Quarto" FontSize="14" TextColor="{StaticResource Muted}" />
        <Label Grid.Row="0" Grid.Column="1" Text="{Binding NomeQuarto}" FontSize="14" HorizontalTextAlignment="End" />
        <Label Grid.Row="1" Text="Hóspedes" FontSize="14" TextColor="{StaticResource Muted}" />
        <Label Grid.Row="1" Grid.Column="1" Text="{Binding ResumoHospedes}" FontSize="14" HorizontalTextAlignment="End" />
        <Label Grid.Row="2" Text="Capacidade" FontSize="14" TextColor="{StaticResource Muted}" />
        <Label Grid.Row="2" Grid.Column="1" Text="{Binding ResumoCapacidade}" FontSize="14" HorizontalTextAlignment="End" />
        <Label Grid.Row="3" Text="Entrada" FontSize="14" TextColor="{StaticResource Muted}" />
        <Label Grid.Row="3" Grid.Column="1" Text="{Binding Checkin, StringFormat='{0:dd/MM/yyyy}'}" FontSize="14" HorizontalTextAlignment="End" />
        <Label Grid.Row="4" Text="Saída" FontSize="14" TextColor="{StaticResource Muted}" />
        <Label Grid.Row="4" Grid.Column="1" Text="{Binding Checkout, StringFormat='{0:dd/MM/yyyy}'}" FontSize="14" HorizontalTextAlignment="End" />
        <Label Grid.Row="5" Text="Diárias" FontSize="14" TextColor="{StaticResource Muted}" />
        <Label Grid.Row="5" Grid.Column="1" Text="{Binding Diarias}" FontSize="14" HorizontalTextAlignment="End" />
        <Label Grid.Row="6" Text="Valor da diária" FontSize="14" TextColor="{StaticResource Muted}" />
        <Label Grid.Row="6" Grid.Column="1" Text="{Binding ValorDiaria, StringFormat='R$ {0:N2}'}" FontSize="14" HorizontalTextAlignment="End" />
      </Grid>
      <BoxView HeightRequest="1" Color="{StaticResource Outline}" />
      <Grid ColumnDefinitions="*,Auto">
        <Label Text="Total" FontSize="18" FontAttributes="Bold" />
        <Label Grid.Column="1" Text="{Binding Total, StringFormat='R$ {0:N2}'}" FontSize="20"
               FontAttributes="Bold" TextColor="{StaticResource Accent}" />
      </Grid>
      <Button Text="Voltar" Clicked="OnVoltarClicked" Margin="0,14,0,0" />
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
