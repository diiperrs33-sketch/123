<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HotelAurora.Views.HospedagemContratada"
             Shell.NavBarIsVisible="False" Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource Canvas}" Title="Resumo">
  <ScrollView>
    <VerticalStackLayout Padding="24,36,24,32" Spacing="20">
      <Label Text="Hotel Aurora" FontSize="17" FontAttributes="Bold" TextColor="{StaticResource Accent}" />
      <VerticalStackLayout Spacing="5">
        <Label Text="Resumo da hospedagem" FontSize="27" FontAttributes="Bold" />
        <Label Text="Confira os dados que você escolheu." FontSize="14" TextColor="{StaticResource Muted}" />
      </VerticalStackLayout>
      <Border BackgroundColor="White" Stroke="{StaticResource Outline}" StrokeShape="RoundRectangle 12" Padding="20">
        <VerticalStackLayout Spacing="18">
          <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="17">
            <Label Grid.Row="0" Text="Quarto" FontSize="14" TextColor="{StaticResource Muted}" />
            <Label Grid.Row="0" Grid.Column="1" Text="{Binding NomeQuarto}" FontSize="14" HorizontalTextAlignment="End" />
            <Label Grid.Row="1" Text="Pessoas" FontSize="14" TextColor="{StaticResource Muted}" />
            <Label Grid.Row="1" Grid.Column="1" Text="{Binding ResumoHospedes}" FontSize="14" HorizontalTextAlignment="End" />
            <Label Grid.Row="2" Text="Entrada" FontSize="14" TextColor="{StaticResource Muted}" />
            <Label Grid.Row="2" Grid.Column="1" Text="{Binding Checkin, StringFormat='{0:dd/MM/yyyy}'}" FontSize="14" HorizontalTextAlignment="End" />
            <Label Grid.Row="3" Text="Saída" FontSize="14" TextColor="{StaticResource Muted}" />
            <Label Grid.Row="3" Grid.Column="1" Text="{Binding Checkout, StringFormat='{0:dd/MM/yyyy}'}" FontSize="14" HorizontalTextAlignment="End" />
            <Label Grid.Row="4" Text="Diárias" FontSize="14" TextColor="{StaticResource Muted}" />
            <Label Grid.Row="4" Grid.Column="1" Text="{Binding Diarias}" FontSize="14" HorizontalTextAlignment="End" />
            <Label Grid.Row="5" Text="Preço por noite" FontSize="14" TextColor="{StaticResource Muted}" />
            <Label Grid.Row="5" Grid.Column="1" Text="{Binding ValorDiaria, StringFormat='R$ {0:N2}'}" FontSize="14" HorizontalTextAlignment="End" />
          </Grid>
          <BoxView HeightRequest="1" Color="{StaticResource Outline}" />
          <Grid ColumnDefinitions="*,Auto">
            <Label Text="Total" FontSize="19" FontAttributes="Bold" />
            <Label Grid.Column="1" Text="{Binding Total, StringFormat='R$ {0:N2}'}" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource Accent}" />
          </Grid>
        </VerticalStackLayout>
      </Border>
      <Label Text="Esse valor é só uma simulação, não é uma reserva real." FontSize="13" TextColor="{StaticResource Muted}" />
      <Button Text="Voltar" Clicked="OnVoltarClicked" />
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>