<?xml version="1.0" encoding="utf-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:HotelAurora.Views"
       x:Class="HotelAurora.AppShell" Title="Hotel Aurora"
       Shell.FlyoutBehavior="Disabled" Shell.NavBarIsVisible="False"
       Shell.TabBarBackgroundColor="White" Shell.TabBarForegroundColor="#426553"
       Shell.TabBarTitleColor="#426553" Shell.TabBarUnselectedColor="#838984">
  <TabBar>
    <ShellContent Title="Reserva" Route="reservar" ContentTemplate="{DataTemplate views:ContratacaoHospedagem}" />
    <ShellContent Title="Sobre" Route="sobre" ContentTemplate="{DataTemplate views:SobrePage}" />
  </TabBar>
</Shell>