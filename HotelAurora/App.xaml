<?xml version="1.0" encoding="utf-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HotelAurora.App">
  <Application.Resources>
    <ResourceDictionary>
      <Color x:Key="Ink">#222831</Color>
      <Color x:Key="Accent">#304C64</Color>
      <Color x:Key="Muted">#66717B</Color>
      <Color x:Key="Canvas">#FFFFFF</Color>
      <Color x:Key="Outline">#D9DDE1</Color>
      <Style TargetType="Label">
        <Setter Property="TextColor" Value="#222831" />
      </Style>
      <Style TargetType="Button">
        <Setter Property="BackgroundColor" Value="#304C64" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="FontAttributes" Value="None" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="HeightRequest" Value="46" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
