<?xml version="1.0" encoding="utf-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="HotelAurora.App">
  <Application.Resources>
    <ResourceDictionary>
      <Color x:Key="Ink">#282D2A</Color>
      <Color x:Key="Accent">#426553</Color>
      <Color x:Key="Muted">#737974</Color>
      <Color x:Key="Canvas">#F7F7F5</Color>
      <Color x:Key="Outline">#E2E6E0</Color>
      <Style TargetType="Label"><Setter Property="TextColor" Value="#282D2A" /></Style>
      <Style TargetType="Button">
        <Setter Property="BackgroundColor" Value="#426553" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="HeightRequest" Value="52" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>